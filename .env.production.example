# =============================================================================
# VARIABLES DE ENTORNO DE PRODUCCIÓN (VPS) — ZERO DELIVERY + VOCERO CRM
# =============================================================================
# Copia este archivo a .env en la raíz del proyecto antes de desplegar:
#   cp .env.production.example .env
# =============================================================================

# --- 1. Dominios Públicos y URLs ---
# Si ya apuntaste tus dominios (A record) a la IP del VPS:
#   DELIVERY_DOMAIN=delivery.tudominio.com
#   VOCERO_DOMAIN=crm.tudominio.com
#   APP_PUBLIC_URL=https://delivery.tudominio.com
#   VOCERO_PUBLIC_URL=https://crm.tudominio.com
#   COOKIE_SECURE=true
# Si vas a probar primero directo con la IP del VPS (sin HTTPS):
DELIVERY_DOMAIN=:8080
VOCERO_DOMAIN=:8081
APP_PUBLIC_URL=http://localhost:3001
VOCERO_PUBLIC_URL=http://localhost:3000
CORS_ORIGINS=*
COOKIE_SECURE=false

# Puertos directos en el VPS (por si accedes por http://IP_VPS:3001 y :3000)
WEB_PORT=3001
VOCERO_PORT=3000

# --- 2. Base de Datos e Infraestructura Zero Delivery ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CAMBIAR_PASSWORD_POSTGRES_SEGURO_2026
POSTGRES_DB=zero_delivery
POSTGRES_PORT=5434

MONGO_ROOT_USERNAME=zero_delivery
MONGO_ROOT_PASSWORD=CAMBIAR_PASSWORD_MONGO_SEGURO_2026
MONGO_PORT=27018

REDIS_PORT=6380

RABBITMQ_DEFAULT_USER=zero_delivery
RABBITMQ_DEFAULT_PASS=CAMBIAR_PASSWORD_RABBIT_SEGURO_2026
RABBITMQ_PORT=5673
RABBITMQ_MANAGEMENT_PORT=15673

# --- 3. Clave Compartida Bidireccional Bot IA (Zero Delivery <-> Vocero CRM) ---
# Debe ser exactamente la misma para ambos sistemas (mínimo 32 caracteres)
VOCERO_BASE_URL=http://vocero-app:3000
VOCERO_BOT_API_KEY=zero-delivery-vocero-shared-bot-key-prod-2026

# --- 4. Vocero CRM (WhatsApp Cloud API & Better Auth) ---
VOCERO_DB_USER=postgres
VOCERO_DB_PASSWORD=CAMBIAR_PASSWORD_VOCERO_DB_2026
VOCERO_DB_NAME=vocero
BETTER_AUTH_SECRET=63e393acb21e0cc8dbec4c172ff4bd76cf90200c204816f8978abdc0fd16159d
ENCRYPTION_KEY=XqTNU14XETr0s71qnkqZMXg1NEQAZmvv8vqqPSnqQ98=
META_WEBHOOK_VERIFY_TOKEN=vocero_verify_token_prod_2026
