# =============================================================================
# ZERO DELIVERY — Variables de Entorno (.env.example)
# =============================================================================

# URL base de Zero Delivery (usa 3001 en dev para convivir con Vocero CRM en 3000)
APP_BASE_URL=http://localhost:3001

# Conexión principal a PostgreSQL 16 (TimeZone=UTC obligatorio)
DATABASE_URL=postgres://postgres:postgres@localhost:5433/zero_delivery

# Secreto para firma y cifrado de sesiones (generar con: openssl rand -hex 32)
SESSION_SECRET=REEMPLAZA_CON_UN_SECRETO_DE_AL_MENOS_32_CARACTERES_HEX

# Tenant por defecto en operación mono-agencia del MVP
DEFAULT_TENANT_SLUG=zero-delivery

# Almacenamiento de archivos (comprobantes Yape, fotos de catálogo, evidencia)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./.storage

# =============================================================================
# INTEGRACIÓN CON VOCERO CRM (Futuro / R1 — controlado por feature.integration.vocero)
# =============================================================================
# URL donde corre la instancia de Vocero CRM (C:\Users\Zero\Documents\max\zero-delivery\vocero-crm)
VOCERO_BASE_URL=http://localhost:3000

# Mismo valor que BOT_API_KEY en el .env de Vocero CRM (mínimo 16 caracteres).
# Se usa tanto para verificar la firma HMAC entrante (X-Vocero-Signature)
# como para autenticar las llamadas salientes hacia /api/bot/* de Vocero CRM.
VOCERO_BOT_API_KEY=REEMPLAZA_CON_EL_BOT_API_KEY_DE_VOCERO_CRM
